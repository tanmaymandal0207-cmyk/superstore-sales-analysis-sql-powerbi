use superstore;
select*
from (orders);
select*
from (customers);
select*
from (products);

/* ---------- DATA OVERVIEW ---------- */

-- Count total records in orders table
select COUNT(*) 
from orders;
/* ---------- SALES ANALYSIS ---------- */

-- Total company sales
select SUM(sales) 
from orders;

-- Sales by region
select 
c.region as Region,
sum(o.sales) as Total_Sales
from customers as c
right join orders as o
on c.customer_id = o.customer_id
group by c.region
		order by Total_sales desc;
		

/* ---------- CUSTOMER ANALYSIS ---------- */

-- Top 10 customers by spending
SELECT 
c.customer_name as Name, 
SUM(o.sales) AS total_spent
FROM orders as o
right join customers as c
on c.customer_id = o.customer_id
GROUP BY Name
ORDER BY total_spent DESC
LIMIT 10;

-- Customer Lifetime Value (Total revenue per customer)
select 
    c.customer_name,
    SUM(o.sales) AS lifetime_value
from orders o
join customers c on o.customer_id = c.customer_id
group by c.customer_name
order by lifetime_value DESC;

-- Average Order Value(AOV)
select
	c.customer_name,
	AVG(o.sales) as avg_order_value
from orders as o
left join customers as c
on c.customer_id = o.customer_id
group by c.customer_name
order by avg_order_value desc;

-- Segment customers based on spending
select
	c.customer_name as Name,
	sum(o.sales) as Total_spent,
	case
		when sum(o.sales) > 5000 then 'High Value'
		when sum(o.sales) between 2000 and 5000 then 'Mid Value'
		else 'Low Value'
	end as customer_segment
from orders as o
left join customers as c
on c.customer_id = o.customer_id
group by name
order by total_spent desc;

-- Repeat vs One_Time Customers
select
	customer_type,
	count(*) as num_customers,
	round(count(*) * 100.0 / sum(count(*)) over (), 2) as percentage
from (
	select
		customer_id,
		case
			when count(order_id) = 1 then 'One-time'
			else 'Repeat'
		end as customer_type
	from orders
	group by customer_id
	) as customer_summary
group by customer_type;
		
-- Number of Order Customer	
select
	c.customer_name as Name,
	count(o.order_id) as total_orders
from customers as c
right join orders as o
on c.customer_id = o.customer_id
group by Name
order by total_orders desc;

/* ---------- PRODUCT ANALYSIS ---------- */	

-- Product Performance		
select
	p.product_name,
	sum(o.sales) as total_sales,
	sum(o.profit) as total_profit
from orders as o
left join products as p
on o.product_id = p.product_id
group by p.product_name
order by total_sales desc;

-- Profit Margin Per Product
select
	p.product_name,
	sum(o.sales) as sales,
	sum(o.profit) as profit,
	(SUM(o.profit)/sum(o.sales)) * 100 as profit_margin
from orders as o
right join products as p
on p.product_id = o.product_id
group by p.product_name
order by profit_margin desc;

-- Products Generating Loss
select
	p.product_name,
	sum(o.profit) as total_loss
from orders as o
left join products as p
on p.product_id = o.product_id
group by p.product_name
having total_loss < 0
order by total_loss;

/* ---------- TIME-BASED ANALYSIS ---------- */	

alter table orders
add column order_date_clean Date;
update orders
set order_date_clean = str_to_date(order_date, '%d-%m-%Y');

-- Monthly Sales Trend
select
	month(order_date_clean) as month,
	sum(sales) as total_sales
from orders
group by month
order by month;                                                                      

-- Yearly Sales
select
	year(order_date_clean) as year,
	sum(sales) as total_sales
from orders
group by year
order by year;

/* ---------- SHIPPING ANALYSIS ---------- */	

alter table orders
add column ship_date_clean Date;
update orders
set ship_date_clean = str_to_date(ship_date, '%d-%m-%Y');

-- Average Delivery Time
select
	avg(datediff(ship_date_clean, order_date_clean)) as avg_delivery_days
from orders;

-- Shipping Mode Efficiency
select 
	ship_mode,
	avg(datediff(ship_date_clean, order_date_clean)) as avg_days
from orders
group by ship_mode;

/* ---------- Discount Impact ---------- */
-- discount vs profit impact
select 
	discount,
	avg(profit) as avg_profit
from orders
group by discount
order by discount;

/* ---------- Customer Ranking ---------- */
-- Rank by Spending
SELECT 
    cs.customer_id,
    cs.total_sales,
    DENSE_RANK() OVER (ORDER BY cs.total_sales DESC) AS customer_rank
FROM (
    SELECT 
        customer_id,
        SUM(sales) AS total_sales
    FROM orders
    GROUP BY customer_id
) AS cs;


create database IPL_PROJECT;

